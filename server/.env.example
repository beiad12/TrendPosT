# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Path to the sqlite dev database (created automatically)
SQLITE_PATH=./data/trendpost.db

# Master key used to encrypt/decrypt user-supplied AI provider API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=replace_with_64_hex_chars_32_bytes

# --- Optional: production Postgres (see docs/schema.sql). When DATABASE_URL is set the
# server can be pointed at Postgres instead of the bundled sqlite dev store. ---
# DATABASE_URL=postgres://user:pass@localhost:5432/trendpost

# --- Optional: Facebook Graph API (OAuth connect for publishing) ---
# FB_APP_ID=
# FB_APP_SECRET=

# --- Optional: Reddit trend source (OAuth "script" app, free) ---
# Without these, Reddit just reports "not_configured" -- the trend engine works fine without it.
# Create one at https://www.reddit.com/prefs/apps ("script" type).
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=TrendPostBot/1.0 (by /u/your_username)

# --- Optional: override the Google News / GDELT endpoints (testing only) ---
# GOOGLE_NEWS_RSS_BASE=https://news.google.com/rss/search
# GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc

# --- Optional: web image search fallback for AI Auto Post (both free, email signup only) ---
# Without either, a trend with no photo of its own just skips straight to AI generation
# instead of trying a web search first. Configure one or both -- they're tried in order
# (Unsplash, then Pexels) per query, so having both widens the odds of a real photo.
# Unsplash: https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=
# UNSPLASH_API_BASE=https://api.unsplash.com
# Pexels: https://www.pexels.com/api/
# PEXELS_API_KEY=
# PEXELS_API_BASE=https://api.pexels.com/v1

# --- AI image generation fallback for AI Auto Post ---
# Pollinations (https://pollinations.ai/) needs NO key -- it's tried automatically as the
# first AI option, free and out of the box on every install. Override its endpoint below
# only for testing against a fixture server.
# POLLINATIONS_API_BASE=https://image.pollinations.ai/prompt
#
# OpenAI's DALL-E is tried second, only if Pollinations fails -- it reuses whatever OpenAI
# key is already configured in Settings for captions, no separate env var needed here.
# OPENAI_IMAGES_API_BASE=https://api.openai.com/v1/images/generations
